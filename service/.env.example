# Copy to service/.env and fill in. Never commit the result.
PORT=3001
# Must name a principal that exists in the realm config.
SERVICE_NAME=service_1

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kerberos
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=

# Principal long-term keys, 32 bytes of hex each:
#   openssl rand -hex 32
# Identical to kdc/.env.
INSAT_AS_KEY=
INSAT_TGS_KEY=
INSAT_SERVICE_1_KEY=
INSAT_SERVICE_2_KEY=
ENIT_AS_KEY=
ENIT_TGS_KEY=
ENIT_SERVICE_1_KEY=
ENIT_SERVICE_2_KEY=
