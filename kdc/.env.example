# Copy to kdc/.env and fill in. Never commit the result.
PORT=5000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Principal long-term keys, 32 bytes of hex each:
#   openssl rand -hex 32
# The KDC seeds these into the Redis keytab at boot, so service/.env must carry
# exactly the same values or the two applications cannot decrypt each other.
INSAT_AS_KEY=
INSAT_TGS_KEY=
INSAT_SERVICE_1_KEY=
INSAT_SERVICE_2_KEY=
ENIT_AS_KEY=
ENIT_TGS_KEY=
ENIT_SERVICE_1_KEY=
ENIT_SERVICE_2_KEY=
